        "# Greedy Multi-Armed Bandit\n",
        "# Incremental Update Method\n",
        "\n",
        "# Number of machines\n",
        "n = int(input(\"Enter number of machines: \"))\n",
        "\n",
        "Q = {}\n",
        "N = {}\n",
        "rewards = {}\n",
        "\n",
        "# Task 1: Initialize\n",
        "for i in range(n):\n",
        "    machine = input(\"Enter machine name: \")\n",
        "    reward_list = list(map(int, input(\"Enter rewards: \").split()))\n",
        "\n",
        "    rewards[machine] = reward_list\n",
        "    Q[machine] = 0\n",
        "    N[machine] = 0\n",
        "\n",
        "print(\"\\n--- Incremental Updates ---\")\n",
        "\n",
        "# Task 2: Update after every play\n",
        "for machine in rewards:\n",
        "\n",
        "    print(f\"\\nMachine {machine}\")\n",
        "\n",
        "    for R in rewards[machine]:\n",
        "\n",
        "        # Increment number of plays\n",
        "        N[machine] += 1\n",
        "\n",
        "        # Incremental update formula\n",
        "        Q[machine] = Q[machine] + (R - Q[machine]) / N[machine]\n",
        "\n",
        "        print(\n",
        "            f\"Reward = {R}, \"\n",
        "            f\"N({machine}) = {N[machine]}, \"\n",
        "            f\"Q({machine}) = {Q[machine]:.2f}\"\n",
        "        )\n",
        "\n",
        "# Task 3: Display final Q values\n",
        "print(\"\\n--- Final Estimated Values ---\")\n",
        "\n",
        "for machine in Q:\n",
        "    print(f\"Machine {machine}\")\n",
        "    print(f\"Rewards: {rewards[machine]}\")\n",
        "    print(f\"Q({machine}) = {Q[machine]:.2f}\")\n",
        "\n",
        "# Greedy selection\n",
        "selected_machine = max(Q, key=Q.get)\n",
        "\n",
        "print(\"\\nGreedy Selected Machine:\", selected_machine)"
