        "#TASK 1\n",
        "# Greedy Multi-Armed Bandit using Arithmetic Mean\n",
        "\n",
        "# Number of machines\n",
        "n = int(input(\"Enter number of machines: \"))\n",
        "\n",
        "machines = {}\n",
        "q_values = {}\n",
        "\n",
        "# Input rewards for each machine\n",
        "for i in range(n):\n",
        "    machine = input(f\"Enter machine name {i + 1}: \")\n",
        "\n",
        "    rewards = list(map(float, input(\n",
        "        f\"Enter rewards for Machine {machine} separated by spaces: \"\n",
        "    ).split()))\n",
        "\n",
        "    machines[machine] = rewards\n",
        "\n",
        "# Calculate Q(a)\n",
        "for machine, rewards in machines.items():\n",
        "    q_value = sum(rewards) / len(rewards)\n",
        "    q_values[machine] = q_value\n",
        "\n",
        "# Display results\n",
        "print(\"\\n--- Estimated Q(a) Values ---\")\n",
        "\n",
        "for machine, rewards in machines.items():\n",
        "    print(f\"\\nMachine {machine}\")\n",
        "\n",
        "    # Display integers without .0\n",
        "    display_rewards = [\n",
        "        int(r) if r.is_integer() else r for r in rewards\n",
        "    ]\n",
        "\n",
        "    print(f\"Rewards: {display_rewards}\")\n",
        "    print(f\"Q({machine}) = {q_values[machine]:.2f}\")\n",
        "\n",
        "# Greedy selection\n",
        "selected_machine = max(q_values, key=q_values.get)\n",
        "\n",
        "print(f\"\\nGreedy Selected Machine: {selected_machine}\")\\"
      ]
